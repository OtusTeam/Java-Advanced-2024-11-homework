            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version> <!-- Updated version -->
                <executions>
                    <execution>
                        <id>jmh-shade</id> <!-- Unique execution ID -->
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <manifestEntries>
                                        <Main-Class>org.openjdk.jmh.Main</Main-Class>
                                    </manifestEntries>
                                </transformer>
                            </transformers>
                            <finalName>benchmarks</finalName>  <!-- Имя JAR-файла -->
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
